# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Only the provider you actually use needs a key.

# Gemini, the default provider. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq, the fallback if a Gemini safety filter trips on ordnance content.
# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Default provider for this project: gemini | groq
DEEPECHO_PROVIDER=gemini
